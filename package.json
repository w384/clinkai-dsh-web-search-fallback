{
  "name": "@clinkai/dsh-web-search-fallback",
  "description": "SearXNG-first web search for the DeepSeek Harness web seam (ctx.web) with automatic fallback to the built-in DeepSeek search when SearXNG/Docker is unreachable.",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "searxng",
    "web-search",
    "fallback",
    "plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-web": ">=0.1.5-rc.2 <1.0.0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-web": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.3",
    "dsh": ">=0.1.5-rc.2 <1.0.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w384/clinkai-dsh-web-search-fallback.git"
  },
  "homepage": "https://github.com/w384/clinkai-dsh-web-search-fallback#readme",
  "bugs": {
    "url": "https://github.com/w384/clinkai-dsh-web-search-fallback/issues"
  }
}
